{
  "$description": "Único lugar del proyecto donde viven los colores. Cada tenant es un tema con tres niveles: primitives -> semantic -> component. Los componentes solo leen semantic y component, nunca primitives.",

  "aurora": {
    "$description": "Casa Aurora: estudio de pastelería artesanal. Claro, cálido, pastel, serif y radios suaves.",

    "primitives": {
      "_comment": "Nivel 1 · Primitivos. La paleta cruda del tenant: valores literales con nombre de material (rosa, cacao, crema). No dicen para qué sirven, solo qué son. Ningún componente los usa directamente.",

      "crema-50": "#fdf8f2",
      "crema-100": "#f7eee3",
      "blanco-0": "#fffdfa",
      "rosa-100": "#fbe6ec",
      "rosa-300": "#f2b6c4",
      "rosa-600": "#c45a74",
      "cacao-200": "#e8dacc",
      "cacao-400": "#a6876f",
      "cacao-600": "#7a5a48",
      "cacao-900": "#3a2419",
      "salvia-400": "#9db592",
      "salvia-700": "#4e6b4b",
      "frambuesa-700": "#b23a48",
      "miel-300": "#f3d9a4",
      "miel-700": "#8a5a12",

      "font-serif": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, serif",

      "radius-soft-sm": "10px",
      "radius-soft-md": "18px",
      "radius-soft-lg": "28px",

      "shadow-soft": "0 22px 44px -26px rgba(58, 36, 25, 0.38)",
      "shadow-softer": "0 8px 20px -12px rgba(58, 36, 25, 0.30)"
    },

    "semantic": {
      "_comment": "Nivel 2 · Semánticos. Nombres de ROL agrupados por familia. Responden a '¿para qué sirve?' y apuntan a un primitivo con {referencia}. Este es el contrato que leen los componentes: igual en todos los tenants, distinto valor en cada uno.",

      "surfaces": {
        "surface": "{crema-50}",
        "surface-elevated": "{blanco-0}",
        "surface-overlay": "{crema-100}"
      },
      "content": {
        "on-surface": "{cacao-900}",
        "text-muted": "{cacao-600}"
      },
      "accent": {
        "accent": "{rosa-300}",
        "on-accent": "{cacao-900}"
      },
      "borders": {
        "border": "{cacao-400}",
        "border-subtle": "{cacao-200}"
      },
      "states": {
        "success": "{salvia-700}",
        "error": "{frambuesa-700}",
        "warning": "{miel-700}",
        "focus": "{rosa-600}"
      },
      "illustration": {
        "art-bg": "{rosa-100}",
        "art-1": "{rosa-300}",
        "art-2": "{salvia-400}",
        "art-3": "{miel-300}"
      },
      "typography": {
        "font-body": "{font-serif}",
        "font-heading": "{font-serif}",
        "heading-weight": "500",
        "heading-style": "italic",
        "heading-transform": "none",
        "heading-tracking": "-0.01em"
      },
      "shape": {
        "radius-sm": "{radius-soft-sm}",
        "radius-md": "{radius-soft-md}",
        "radius-lg": "{radius-soft-lg}",
        "border-width": "1px"
      },
      "spacing": {
        "space-section": "88px",
        "space-card": "28px"
      },
      "elevation": {
        "shadow-card": "{shadow-soft}",
        "shadow-raised": "{shadow-softer}"
      }
    },

    "component": {
      "_comment": "Nivel 3 · Componentes (opcional). Decisiones de un componente concreto, siempre apuntando a un semántico. Si cambias 'accent', 'btn-bg' cambia solo.",

      "btn-bg": "{accent}",
      "btn-fg": "{on-accent}",
      "btn-radius": "{radius-lg}",
      "btn-secondary-fg": "{on-surface}",
      "btn-secondary-border": "{border}",
      "card-bg": "{surface-elevated}",
      "card-fg": "{on-surface}",
      "card-border": "{border-subtle}",
      "card-radius": "{radius-lg}",
      "card-shadow": "{shadow-card}",
      "input-bg": "{surface}",
      "input-border": "{border}",
      "input-radius": "{radius-md}",
      "logo-radius": "{radius-lg}"
    }
  },

  "molino": {
    "$description": "Molino Central: panificadora industrial que abastece de pan a tiendas y restaurantes. Oscuro e industrial: grafito y acero, amarillo de seguridad, sans robusta, esquinas rectas y bordes marcados, sin brillos.",

    "primitives": {
      "_comment": "Nivel 1 · Primitivos. La paleta cruda del tenant: grafito, acero, harina y amarillo de seguridad. No dicen para qué sirven, solo qué son. Ningún componente los usa directamente.",

      "grafito-950": "#121417",
      "grafito-900": "#1b1f24",
      "grafito-800": "#262b32",
      "acero-800": "#2b3642",
      "acero-700": "#3a4a5c",
      "acero-400": "#7d93ab",
      "acero-200": "#aeb9c6",
      "harina-50": "#f4f1ea",
      "harina-300": "#d9cfbd",
      "amarillo-400": "#ffc20e",
      "verde-400": "#4cc38a",
      "rojo-400": "#ff6b5b",
      "naranja-400": "#ff9f1c",
      "azul-300": "#6cb6ff",

      "font-industrial": "\"Helvetica Neue\", Arial, system-ui, sans-serif",

      "radius-none": "0px",
      "radius-hair": "2px",

      "sombra-ninguna": "none"
    },

    "semantic": {
      "_comment": "Nivel 2 · Semánticos. Los MISMOS nombres de rol que Casa Aurora, con otros valores. Por eso el mismo componente se ve completamente distinto.",

      "surfaces": {
        "surface": "{grafito-950}",
        "surface-elevated": "{grafito-900}",
        "surface-overlay": "{grafito-800}"
      },
      "content": {
        "on-surface": "{harina-50}",
        "text-muted": "{acero-200}"
      },
      "accent": {
        "accent": "{amarillo-400}",
        "on-accent": "{grafito-950}"
      },
      "borders": {
        "border": "{acero-400}",
        "border-subtle": "{acero-700}"
      },
      "states": {
        "success": "{verde-400}",
        "error": "{rojo-400}",
        "warning": "{naranja-400}",
        "focus": "{azul-300}"
      },
      "illustration": {
        "art-bg": "{acero-800}",
        "art-1": "{amarillo-400}",
        "art-2": "{acero-400}",
        "art-3": "{harina-300}"
      },
      "typography": {
        "font-body": "{font-industrial}",
        "font-heading": "{font-industrial}",
        "heading-weight": "800",
        "heading-style": "normal",
        "heading-transform": "uppercase",
        "heading-tracking": "0.04em"
      },
      "shape": {
        "radius-sm": "{radius-none}",
        "radius-md": "{radius-hair}",
        "radius-lg": "{radius-hair}",
        "border-width": "2px"
      },
      "spacing": {
        "space-section": "64px",
        "space-card": "22px"
      },
      "elevation": {
        "shadow-card": "{sombra-ninguna}",
        "shadow-raised": "{sombra-ninguna}"
      }
    },

    "component": {
      "_comment": "Nivel 3 · Componentes (opcional). Mismas claves que Casa Aurora. El botón no sabe qué tenant está activo: solo lee 'btn-bg'.",

      "btn-bg": "{accent}",
      "btn-fg": "{on-accent}",
      "btn-radius": "{radius-sm}",
      "btn-secondary-fg": "{on-surface}",
      "btn-secondary-border": "{border}",
      "card-bg": "{surface-elevated}",
      "card-fg": "{on-surface}",
      "card-border": "{border}",
      "card-radius": "{radius-lg}",
      "card-shadow": "{shadow-card}",
      "input-bg": "{surface}",
      "input-border": "{border}",
      "input-radius": "{radius-sm}",
      "logo-radius": "{radius-sm}"
    }
  }
}
